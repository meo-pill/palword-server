######## BUILDER STAGE ########
# Télécharge et installe les fichiers du jeu via SteamCMD
FROM steamcmd/steamcmd:latest AS builder

ENV APP_ID=2394010
ENV APPLOCATION=/home/palword/PalwordGame

RUN steamcmd +force_install_dir ${APPLOCATION} +login anonymous +app_update ${APP_ID} validate +quit

######## RUNTIME STAGE ########
# Image finale minimaliste : uniquement les dépendances runtime + les fichiers du jeu copiés depuis le builder
FROM ubuntu:22.04

LABEL description="Palword dedicated server (slim, sans SSH)"
LABEL version="1.0.0-slim"

ENV USER=palword
ENV HOME=/home/palword
ENV CONFIG_DIR=/PalwordConfig
ENV APPLOCATION=/home/palword/PalwordGame
ENV SAVE_DIR=${APPLOCATION}/Pal/Saved
ENV APP_ID=2394010
ENV MAX_BACKUPS=24
ENV BACKUP_INTERVAL=3600
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# Active l'architecture 32-bit et installe uniquement les dépendances runtime nécessaires
# (sans openssh-server, htop, nano, iputils-ping, software-properties-common)
RUN dpkg --add-architecture i386 \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        screen \
        curl \
        wget \
        ca-certificates \
        lib32gcc-s1 \
        lib32stdc++6 \
        libc6-i386 \
        libcurl4:i386 \
        net-tools \
        procps \
        tzdata \
        cron \
        sudo \
    && apt-get autoremove -y \
    && apt-get autoclean \
    && rm -rf /var/lib/apt/lists/* \
    && rm -rf /var/cache/apt/* \
    && rm -rf /tmp/* \
    && rm -rf /var/tmp/*

# Création de l'utilisateur (sans groupe developer qui n'est utile que pour l'accès SSH)
RUN groupadd -g 5000 game-server \
    && useradd -u 3009 -g game-server -m -s /bin/bash palword \
    && echo "palword ALL=(ALL) NOPASSWD: /usr/sbin/service, /etc/init.d/cron" >> /etc/sudoers.d/palword \
    && mkdir -p ${APPLOCATION} \
    && chown -R palword:game-server /home/palword

# Copie des fichiers du jeu depuis le builder (évite d'embarquer SteamCMD dans l'image finale)
COPY --from=builder --chown=palword:game-server /home/palword/PalwordGame ${APPLOCATION}

WORKDIR $HOME

# Création des répertoires persistants avec les bonnes permissions
RUN mkdir -p ${CONFIG_DIR} ${SAVE_DIR} \
    && chown -R palword:game-server ${CONFIG_DIR} ${SAVE_DIR} \
    && chmod -R 775 ${CONFIG_DIR}

# Copie de la configuration et des scripts
COPY --chown=palword:game-server ./config/DefaultPalWorldSettings.ini ${APPLOCATION}/DefaultPalWorldSettings.ini
COPY --chown=palword:game-server ./app/launch.sh ./entrypoint.slim.sh ./healthcheck.sh /home/palword/

RUN chmod +x /home/palword/launch.sh \
    && chmod +x /home/palword/entrypoint.slim.sh \
    && chmod +x /home/palword/healthcheck.sh

# Cron job pour redémarrage quotidien à 14h00
RUN (echo "0 14 * * * /home/palword/launch.sh restart") | crontab -u palword -

# Variables d'environnement et PATH dans le shell
RUN echo 'export CONFIG_DIR=/PalwordConfig' >> /home/palword/.bashrc \
    && echo 'export APPLOCATION=/home/palword/PalwordGame' >> /home/palword/.bashrc \
    && echo 'export SAVE_DIR=${APPLOCATION}/Pal/Saved' >> /home/palword/.bashrc \
    && echo 'PATH="/home/palword/PalwordGame:${PATH}"' >> /home/palword/.bashrc \
    && echo 'PATH="${HOME}:${PATH}"' >> /home/palword/.bashrc \
    && echo 'export PATH' >> /home/palword/.bashrc

ENV PATH="/home/palword/PalwordGame:${PATH}"
ENV PATH="${HOME}:${PATH}"

VOLUME ["${CONFIG_DIR}", "${SAVE_DIR}"]

# Port de jeu Palworld
EXPOSE 8211
# Port Steam query
EXPOSE 27015

USER palword
WORKDIR ${CONFIG_DIR}

ENTRYPOINT ["/home/palword/entrypoint.slim.sh"]

HEALTHCHECK --interval=60s --timeout=10s --start-period=120s --retries=3 \
    CMD /home/palword/healthcheck.sh
